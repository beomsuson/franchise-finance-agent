# Streamlit Community Cloud > App settings > Secrets 에 이 내용을 붙여넣고 실제 값으로 채우세요.
# 이 파일 자체(.example)는 예시일 뿐이라 그대로 올려도 안전하지만,
# 실제 값을 채운 secrets.toml은 절대 GitHub에 커밋하지 마세요(.gitignore에 이미 포함).

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-5.6-luna"

# DB는 franchise_agent/franchise.db(SQLite, 리포에 이미 포함됨)를 그대로 쓰므로
# 별도 DB 접속정보는 필요 없습니다.
